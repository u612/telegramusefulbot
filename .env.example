BOT_TOKEN=your_bot_token_here

DATABASE_URL=postgresql://username:password@host:5432/database

MAX_FILE_SIZE=52428800

TEMP_FOLDER=/tmp/telegram_bot

LOG_LEVEL=INFO

REDIS_URL=

LIBREOFFICE_TIMEOUT=60

OCR_TIMEOUT=120

SUBPROCESS_TIMEOUT=60

MAX_CONCURRENT_HEAVY_JOBS=2

MAX_FILES_PER_BATCH=20

# Telegram numeric user id of the bot owner (unlimited merge queue,
# /upgrade, /userbot_on, /userbot_off, /status). Leave blank/0 to disable
# owner privileges entirely.
OWNER_ID=

# Default merge-queue size for users who haven't been /upgrade'd.
DEFAULT_PDF_QUEUE_LIMIT=20

# Optional: userbot (MTProto) transport for Merge files too large for the
# public Bot API (~20MB download ceiling). All three required to enable it;
# even then it stays off until the owner runs /userbot_on. Generate
# USERBOT_SESSION_STRING once locally with Pyrogram (see README), then
# paste it here -- never commit it.
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_SESSION_STRING=
